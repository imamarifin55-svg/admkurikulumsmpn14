{
  "entities": {
    "CurriculumDocument": {
      "title": "CurriculumDocument",
      "description": "Dokumen kurikulum, silabus, ATP, Modul Ajar, Prota, Promes yang diunggah oleh guru",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 300 },
        "originalFileName": { "type": "string", "maxLength": 255 },
        "fileSize": { "type": "number" },
        "fileType": { "type": "string", "maxLength": 20 },
        "category": { "type": "string", "maxLength": 50 },
        "subject": { "type": "string", "maxLength": 100 },
        "grade": { "type": "string", "enum": ["7", "8", "9"] },
        "semester": { "type": "string", "enum": ["ganjil", "genap"] },
        "academicYear": { "type": "string", "maxLength": 20 },
        "curriculumType": { "type": "string", "maxLength": 50 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 150 },
        "teacherNip": { "type": "string", "maxLength": 50 },
        "teacherEmail": { "type": "string", "maxLength": 150 },
        "alokasiJp": { "type": "number" },
        "competencies": { "type": "array" },
        "uploadDate": { "type": "string" },
        "lastModified": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "diajukan", "diverifikasi", "disahkan", "perlu_revisi"] },
        "supervisorNotes": { "type": "string", "maxLength": 1000 },
        "verificationDate": { "type": "string" },
        "verifiedBy": { "type": "string", "maxLength": 150 },
        "approvalNumber": { "type": "string", "maxLength": 100 },
        "contentPreview": { "type": "string", "maxLength": 2000 },
        "externalFileUrl": { "type": "string", "maxLength": 500 },
        "hasStoredFile": { "type": "boolean" },
        "tags": { "type": "array" }
      },
      "required": ["id", "title", "category", "subject", "grade", "semester", "academicYear", "status", "uploadDate"]
    },
    "DocumentFile": {
      "title": "DocumentFile",
      "description": "Header & isi berkas fisik dokumen kurikulum (otomatis terpecah ke chunks bila > 550 KB, maks 10 MB)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "documentId": { "type": "string", "maxLength": 128 },
        "fileName": { "type": "string", "maxLength": 255 },
        "mimeType": { "type": "string", "maxLength": 120 },
        "fileSize": { "type": "number" },
        "dataUrl": { "type": "string", "maxLength": 900000 },
        "isChunked": { "type": "boolean" },
        "chunkCount": { "type": "number" },
        "uploadedAt": { "type": "string" }
      },
      "required": ["id", "documentId", "fileName", "dataUrl", "uploadedAt"]
    },
    "DocumentFileChunk": {
      "title": "DocumentFileChunk",
      "description": "Potongan data berkas berukuran besar (> 550 KB hingga 10 MB) agar tersimpan langsung di Firestore tanpa Google Drive",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "documentId": { "type": "string", "maxLength": 128 },
        "chunkIndex": { "type": "number" },
        "totalChunks": { "type": "number" },
        "data": { "type": "string", "maxLength": 750000 }
      },
      "required": ["id", "documentId", "chunkIndex", "totalChunks", "data"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Catatan riwayat aktivitas unggah, telaah, revisi, pengesahan, dan perubahan konfigurasi",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 50 },
        "actorName": { "type": "string", "maxLength": 150 },
        "actorRole": { "type": "string", "enum": ["waka_kurikulum", "guru"] },
        "targetTitle": { "type": "string", "maxLength": 300 },
        "details": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "action", "actorName", "actorRole", "timestamp"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil pengguna yang terafiliasi dengan Waka Kurikulum atau Guru Mata Pelajaran",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["waka_kurikulum", "guru"] },
        "teacherId": { "type": "string" },
        "nip": { "type": "string" },
        "subject": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "SchoolProfile": {
      "title": "SchoolProfile",
      "description": "Profil identitas sekolah, kepala sekolah, waka kurikulum, PIN akses Waka, logo & tanda tangan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "npsn": { "type": "string" },
        "address": { "type": "string" },
        "district": { "type": "string" },
        "province": { "type": "string" },
        "principalName": { "type": "string" },
        "principalNip": { "type": "string" },
        "curriculumViceName": { "type": "string" },
        "curriculumViceNip": { "type": "string" },
        "currentAcademicYear": { "type": "string" },
        "currentSemester": { "type": "string" },
        "wakaPin": { "type": "string", "maxLength": 20 },
        "headmasterSignatureUrl": { "type": "string" },
        "wakaSignatureUrl": { "type": "string" }
      },
      "required": ["id", "name", "npsn"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Data guru pengampu mata pelajaran beserta NIP dan email belajar.id",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "nip": { "type": "string", "maxLength": 50 },
        "subject": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "maxLength": 150 }
      },
      "required": ["id", "name", "nip", "subject", "email"]
    },
    "CategoryItem": {
      "title": "CategoryItem",
      "description": "Kategori instrumen perangkat pembelajaran sekolah",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 20 },
        "name": { "type": "string", "maxLength": 150 },
        "defaultJp": { "type": "number" },
        "description": { "type": "string", "maxLength": 500 },
        "isSupervisedInMatrix": { "type": "boolean" },
        "isSystemDefault": { "type": "boolean" }
      },
      "required": ["id", "code", "name", "defaultJp", "isSupervisedInMatrix"]
    }
  },
  "firestore": {
    "/documents/{documentId}": {
      "schema": "CurriculumDocument",
      "description": "Koleksi seluruh berkas kurikulum sekolah"
    },
    "/document_files/{fileId}": {
      "schema": "DocumentFile",
      "description": "Koleksi berkas fisik lampiran dokumen untuk pratinjau & unduh real-time"
    },
    "/document_file_chunks/{chunkId}": {
      "schema": "DocumentFileChunk",
      "description": "Potongan data berkas lampiran berukuran besar (> 550 KB hingga 10 MB)"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Riwayat audit aktivitas kurikulum lintas pengguna dan perangkat"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Profil dan peran akses pengguna (Waka vs Guru)"
    },
    "/school_config/{configId}": {
      "schema": "SchoolProfile",
      "description": "Konfigurasi identitas sekolah, PIN Waka, logo dan tanda tangan resmi"
    },
    "/teachers/{teacherId}": {
      "schema": "Teacher",
      "description": "Daftar guru pengampu mata pelajaran sekolah"
    },
    "/categories/{categoryId}": {
      "schema": "CategoryItem",
      "description": "Daftar kategori perangkat pembelajaran"
    }
  }
}
