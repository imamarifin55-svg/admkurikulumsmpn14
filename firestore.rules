rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection (Username + Role sessions)
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow write: if isValidId(userId)
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 150
        && request.resource.data.role in ['waka_kurikulum', 'guru'];
    }

    // School Profile Config (including logos, signatures, and Waka PIN)
    match /school_config/{configId} {
      allow read: if true;
      allow write: if isValidId(configId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.npsn is string
        && request.resource.data.npsn.size() <= 30;
    }

    // Curriculum Documents
    match /documents/{documentId} {
      allow read: if true;
      allow create, update: if isValidId(documentId)
        && request.resource.data.id == documentId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && request.resource.data.semester in ['ganjil', 'genap']
        && request.resource.data.status in ['draft', 'diajukan', 'diverifikasi', 'disahkan', 'perlu_revisi'];
      allow delete: if isValidId(documentId);
    }

    // Attached Physical Document Files header/payload (<= ~900KB base64 payload or 'CHUNKED' header)
    match /document_files/{fileId} {
      allow read: if isValidId(fileId);
      allow create, update: if isValidId(fileId)
        && request.resource.data.id == fileId
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() > 0
        && request.resource.data.fileName.size() <= 255
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() > 0
        && request.resource.data.dataUrl.size() <= 900000;
      allow delete: if isValidId(fileId);
    }

    // Chunked slices for large physical files (> 550KB up to 10MB)
    match /document_file_chunks/{chunkId} {
      allow read: if isValidId(chunkId);
      allow create, update: if isValidId(chunkId)
        && request.resource.data.id == chunkId
        && request.resource.data.documentId is string
        && request.resource.data.documentId.size() > 0
        && request.resource.data.documentId.size() <= 128
        && request.resource.data.chunkIndex is int
        && request.resource.data.chunkIndex >= 0
        && request.resource.data.chunkIndex <= 50
        && request.resource.data.totalChunks is int
        && request.resource.data.totalChunks > 0
        && request.resource.data.totalChunks <= 50
        && request.resource.data.data is string
        && request.resource.data.data.size() > 0
        && request.resource.data.data.size() <= 750000;
      allow delete: if isValidId(chunkId);
    }

    // Immutable Activity / Audit Logs
    match /activity_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId)
        && request.resource.data.id == logId
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 50
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() > 0
        && request.resource.data.actorName.size() <= 150
        && request.resource.data.actorRole in ['waka_kurikulum', 'guru'];
      allow update, delete: if false;
    }

    // Teachers Directory
    match /teachers/{teacherId} {
      allow read: if true;
      allow create, update: if isValidId(teacherId)
        && request.resource.data.id == teacherId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 150;
      allow delete: if isValidId(teacherId);
    }

    // Categories Directory
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isValidId(categoryId)
        && request.resource.data.id == categoryId
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 20
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 150;
      allow delete: if isValidId(categoryId);
    }
  }
}
