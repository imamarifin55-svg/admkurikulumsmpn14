rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection (Username + Role sessions)
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow write: if isValidId(userId)
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 150
        && request.resource.data.role in ['waka_kurikulum', 'guru'];
    }

    // School Profile Config
    match /school_config/{configId} {
      allow read: if true;
      allow write: if isValidId(configId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.npsn is string
        && request.resource.data.npsn.size() <= 30;
    }

    // Curriculum Documents
    match /documents/{documentId} {
      allow read: if true;
      allow create, update: if isValidId(documentId)
        && request.resource.data.id == documentId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && request.resource.data.semester in ['ganjil', 'genap']
        && request.resource.data.status in ['draft', 'diajukan', 'diverifikasi', 'disahkan', 'perlu_revisi'];
      allow delete: if isValidId(documentId);
    }

    // Teachers Directory
    match /teachers/{teacherId} {
      allow read: if true;
      allow create, update: if isValidId(teacherId)
        && request.resource.data.id == teacherId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 150;
      allow delete: if isValidId(teacherId);
    }

    // Categories Directory
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isValidId(categoryId)
        && request.resource.data.id == categoryId
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 20
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 150;
      allow delete: if isValidId(categoryId);
    }
  }
}
